---
// "I build": the differentiator. A terminal that types out the tools and sites I have shipped.
const lines = [
  ['c', '$ abhay --built'],
  ['', ''],
  ['', 'blog-audit-checker   Python + AI   25–30 min → 6–8 min per blog'],
  ['', 'site-health-check    weekly        prices, forms, OTP, WhatsApp, RERA'],
  ['', 'whatsapp-flows       Wati          qualify, tag, nurture, hand over'],
  ['', 'capi-pipelines       Meta          offline conversions, lookalikes'],
  ['', 'websites             Astro/GSAP    94–99 mobile Lighthouse'],
  ['', 'motion-films         code          beat-synced brand films and ads'],
  ['', ''],
  ['d', '# B.Tech CSE (GGSIPU, 2024). I write the tools my campaigns need.'],
];
const html = lines.map(([c, t]) => `<span class="tl ${c}" data-tl>${t.replace(/&/g, '&amp;').replace(/</g, '&lt;')}\n</span>`).join('');
---
<section id="build">
  <div class="wrap build">
    <div style="display:grid;gap:22px">
      <p class="eyebrow rv">I build</p>
      <h2 class="h2 rv">A marketer <em>who ships code.</em></h2>
      <p class="lead rv">Most marketers wait for a developer. I write the tracking, the automations and the audit tools myself, so campaigns move faster and every number can be checked.</p>
    </div>
    <div class="term rv" data-term>
      <div class="term-bar"><i></i><i></i><i></i></div>
      <pre set:html={html} />
    </div>
  </div>
</section>
