---
// Selected work: six big media cards (video where we have it). Cards bend with scroll speed on desktop.
import { roles } from '../../data/me';
import { small } from '../../data/img';
const pick = [
  { slug: 'county-group', stats: true, head: '₹50L+ a month across 6 luxury projects; Meta qualification lifted to 17.9%.' },
  { slug: 'machan-earavat', img: 'hosp/weddings.webp', head: '₹1.4 Cr+ in direct bookings on ₹1.2L of ads, for weddings, retreats and stays.' },
  { slug: 'dohful', video: 'drive/dohful/10', vert: true, head: '₹45K of Diwali ads became ₹13.2L in 28 days.' },
  { slug: 'travel', video: 'ads/reel-maldives', vert: true, head: '10,500+ trip enquiries across six destinations.' },
  { slug: 'the-better-beings', img: 'show/the-better-beings/01.webp', head: 'A mobile-first Shopify store and Meta engine for an electrolyte brand.' },
  { slug: 'web-and-motion', video: 'motion/omkarix-brand-film', head: 'Websites at 94 to 99 on mobile, with a brand film made in code.' },
].map((x) => ({ ...x, r: roles.find((r) => r.slug === x.slug)! }));
---
<section id="work">
  <div class="wrap">
    <div style="display:grid;gap:22px;margin-bottom:72px">
      <p class="eyebrow rv">Selected work</p>
      <h2 class="h2 rv">Spend in. <em>Revenue out.</em></h2>
    </div>
    <div class="wgrid">
      {pick.map((x) => (
        <a class="wcard" href={`/work/${x.slug}/`} data-bend data-cursor-text="VIEW">
          <span class={`wmedia${x.vert ? ' vert' : ''}`} data-reveal style={x.vert ? `--poster:url(/work/${x.video}.jpg)` : undefined}>
            {x.stats
              ? <span class="wstats">{x.r.metrics!.map(([v, l]) => <span><b>{v}</b><small>{l}</small></span>)}</span>
              : x.video
              ? <video muted loop playsinline preload="none" poster={`/work/${x.video}.jpg`} data-src={`/work/${x.video}.mp4`} aria-hidden="true"></video>
              : <img src={small(x.img!)} srcset={`${small(x.img!)} 700w, /work/${x.img} 1400w`} sizes="(max-width: 860px) 92vw, 46vw" alt={`${x.r.org} work`} loading="lazy" decoding="async" />}
          </span>
          <span class="wmeta"><b data-scramble>{x.r.org}</b><span>{x.r.metrics?.[0]?.[0]}</span></span>
          <span class="whead">{x.head}</span>
        </a>
      ))}
    </div>
  </div>
</section>
