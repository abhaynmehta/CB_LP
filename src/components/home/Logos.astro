---
// Brands I have grown, as a slow endless strip (pauses on hover).
const logos = [['machaan', 'Corbett Machaan'], ['earavat', 'Earavat Resort'], ['tbb', 'The Better Beings'], ['dohful', 'Dohful'], ['wanderlynk', 'WanderLynk'], ['canopy', 'Canopy & Sky'], ['pushpak', 'Pushpak Tours'], ['omkarix', 'Omkarix Global Exim'], ['printculture', 'The Print Culture'], ['digitalfutur', 'The Digital Futur']];
const size: Record<string, [number, number]> = {"canopy": [121, 140], "digitalfutur": [196, 99], "dohful": [134, 140], "earavat": [360, 88], "machaan": [246, 57], "omkarix": [143, 140], "printculture": [360, 57], "pushpak": [266, 57], "tbb": [175, 140], "wanderlynk": [145, 140]};
const row = logos.map(([f, n]) => `<img src="/work/logos/${f}.webp" alt="${n}" width="${size[f][0]}" height="${size[f][1]}" loading="lazy" decoding="async" />`).join('');
---
<div class="logos">
  <p class="cap">Brands I have grown</p>
  <div class="logo-row"><div set:html={row} /><div set:html={row} aria-hidden="true" /></div>
</div>
