---
// Hero: a WebGL field of points (the noise) that settles into a rising growth curve as you scroll.
import { me, stats } from '../../data/me';
---
<section class="hero" id="top">
  <canvas data-field aria-hidden="true"></canvas>
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-in">
    <p class="eyebrow rv">Delhi NCR · Performance marketing, SEO and automation</p>
    <h1 class="display" data-hero-name>
      <span class="ln"><span>Abhay</span></span>
      <span class="ln"><span><em>Mehta</em></span></span>
    </h1>
    <div class="hero-role rv">
      <p>{me.role}. {me.short} Five years, 40+ clients, one rule: report what moved.</p>
      <div class="ctas">
        <a class="btn sig" href={me.cv} download>Download CV ↓</a>
        <a class="btn" href={`mailto:${me.email}`}>Email me</a>
        <a class="btn" href={me.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
      </div>
    </div>
    <div class="stats">
      {stats.map(([v, l]) => <div class="stat rv"><b data-count>{v}</b><span>{l}</span></div>)}
    </div>
  </div>
</section>
