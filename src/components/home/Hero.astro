---
// Hero: the showreel, full bleed (silent background cut; the 9:16 cut on portrait screens). Name and
// pitch sit on a shade at the bottom. The chapter bar is the reel's table of contents: each client and
// its result, a progress line that follows the film, and a click jumps the film to that chapter.
import { me } from '../../data/me';
import { letters } from '../../data/text';
// Start and end of each chapter in the film, in seconds, measured frame by frame from the render.
const chapters: [number, number, string, string][] = [
  [0, 3, 'Dohful', '28.9x ROAS'],
  [3, 6.8, 'Machan & Earavat', '₹1.4 Cr+'],
  [6.8, 8.9, 'Real estate', '₹22.4 Cr+'],
  [8.9, 10.9, 'Travel', '10,500+'],
  [10.9, 12, 'County Group', '17.9%'],
  [12, 17, 'Snapchat India', '1.09B views'],
  [17, 24, 'Sites & films', '94–99'],
];
---
<section class="hero cine" id="top" data-cine>
  <div class="cine-media" data-cine-media aria-hidden="true">
    <video muted loop playsinline preload="metadata" poster="/work/motion/showreel-16x9.jpg"
      data-wide="/work/motion/showreel-bg-16x9.mp4" data-tall="/work/motion/showreel-bg-9x16.mp4" data-tall-poster="/work/motion/showreel-9x16.jpg"></video>
  </div>
  <div class="cine-shade" aria-hidden="true"></div>
  <div class="hero-meta cap" aria-hidden="true">
    <span>Portfolio <b>’26</b> · Showreel</span>
    <span>Delhi <b data-clock>--:--</b> IST</span>
  </div>
  <div class="cine-dock wrap" data-cine-dock>
    <div class="cine-row">
      <h1 class="cine-name" data-hero-name aria-label={me.name}>
        <span class="ln" aria-hidden="true"><span set:html={letters('Abhay')} /></span>
        <span class="ln" aria-hidden="true"><span><em set:html={letters('Mehta')} /></span></span>
      </h1>
      <p class="cine-line"><b>I turn ad spend into revenue, and prove it.</b> Monthly budgets up to ₹1 Cr, 40+ brands, five years. A performance marketer who writes his own code.</p>
      <div class="cine-act">
        <div class="ctas">
          <a class="btn gold" href="#work" data-magnet>See the work</a>
          <a class="btn" href={me.cv} download data-magnet>CV ↓</a>
        </div>
        <button class="cine-watch" type="button" data-reel data-magnet aria-label="Watch the showreel with sound">
          <svg viewBox="0 0 120 120" aria-hidden="true"><defs><path id="wr" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0" /></defs><text textLength="286" lengthAdjust="spacing"><textPath href="#wr">WATCH WITH SOUND ✦ SHOWREEL ✦ </textPath></text></svg>
          <span>▶</span>
        </button>
      </div>
    </div>
    <ol class="cine-chap" data-chapters aria-label="Showreel chapters">
      {chapters.map(([s, e, n, m]) => (
        <li><button type="button" data-t={s} data-e={e}><i><b></b></i><span class="cap">{n}</span><em>{m}</em></button></li>
      ))}
    </ol>
  </div>
  <dialog class="showreel" data-reel-dlg aria-label="Showreel">
    <video controls playsinline preload="none" poster="/work/motion/showreel-16x9.jpg" data-wide="/work/motion/showreel-16x9.mp4" data-tall="/work/motion/showreel-9x16.mp4"></video>
    <button class="btn showreel-x" type="button" data-reel-close>Close ✕</button>
  </dialog>
</section>
