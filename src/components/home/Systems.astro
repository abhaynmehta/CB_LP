---
// The green room: systems I built, in plain words. Ads bring the lead; these turn it into a sale and
// keep every number checkable. Each panel shows the system working and the result it produced.
// The chat, the sorted leads and the checklist illustrate the real flows; the results are from the CV.
const chat: [string, string][] = [
  ['in', 'Hi! Looking at Machan for a wedding in February 🌿'],
  ['out', 'Congratulations! Here is our wedding brochure 📎 Weddings-at-Machan.pdf'],
  ['out', 'How many guests are you planning for?'],
  ['in', 'Around 120'],
  ['out', 'Lovely. Which dates are you considering?'],
  ['in', '14 to 16 Feb'],
];
// The bot's sort, as in the real Wati flows: hot to sales, warm into a 1-day and 3-day nurture, cold gets the brochure.
// Leads are illustrative; k is the order they arrive in.
const cols: [string, string, [string, string, number][]][] = [
  ['Hot', 'Sales call today', [['3BHK · ₹3 Cr+ · visit this week', '3BHK · this week', 0], ['4BHK · ready to move', '4BHK · ready', 3]]],
  ['Warm', 'Nurture · day 1, day 3', [['2BHK · buying next quarter', '2BHK · next qtr', 2], ['Villa · comparing projects', 'Villa · comparing', 4]]],
  ['Cold', 'Brochure sent', [['Just browsing prices', 'Browsing', 1], ['Asked about rentals', 'Rentals', 5]]],
];
const checks = ['Facts match the project sheet', 'Schema and FAQ markup present', 'Answers an AI engine can quote', 'Internal links and CTAs', 'Prices, forms and WhatsApp live'];
---
<section class="lab sys" id="systems">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow rv">Systems I built</p>
      <h2 class="h2 rv">Automation that <em>pays for itself.</em></h2>
      <p class="lead rv">Ads bring the lead. These systems turn it into a sale, and make every number checkable. I design them, build them and run them.</p>
    </div>
    <div class="sys-grid">
      <article class="sys-card sys-chat rv" data-sys>
        <div class="sys-head"><span class="cap">01 · WhatsApp concierge</span><span class="cap">Machan & Earavat</span></div>
        <div class="wa" aria-hidden="true">
          <div class="wa-top"><i>M</i><span><b>Machan Concierge</b><small>Usually replies instantly</small></span></div>
          <div class="wa-body">
            {chat.map(([d, t], i) => <p class={`wa-m ${d}`} style={`--k:${i}`}>{t}</p>)}
            <p class="wa-tag" style={`--k:${chat.length}`}>Tagged <b>HOT</b> · Wedding · 120 guests · sent to sales</p>
          </div>
        </div>
        <div class="sys-res"><b>22%</b><span>of WhatsApp chats became bookings, against a 4 to 8% hospitality benchmark</span></div>
      </article>
      <article class="sys-card sys-sort rv" data-sys>
        <div class="sys-head"><span class="cap">02 · Lead qualification bot</span><span class="cap">Real estate</span></div>
        <div class="sort" aria-hidden="true">
          <div class="sort-in"><i></i>New enquiries · the bot asks budget, size and timing</div>
          <div class="sort-cols">
            {cols.map(([name, next, leads]) => (
              <div class={`sc ${name.toLowerCase()}`}>
                <header><b>{name}</b><span class="cap">{next}</span></header>
                {leads.map(([long, short, k], slot) => (
                  <span class="tok" style={`--k:${k};--dx:${name === 'Hot' ? 33.3 : name === 'Cold' ? -33.3 : 0};--sy:${-(104 + slot * 54)}px`}><i></i><span class="tok-l">{long}</span><span class="tok-s">{short}</span></span>
                ))}
              </div>
            ))}
          </div>
        </div>
        <div class="sys-res"><b>₹22.4 Cr+</b><span>qualified pipeline in 90 days across 12+ accounts: hot leads to sales the same day, the rest nurtured on WhatsApp</span></div>
      </article>
      <article class="sys-card sys-qc rv" data-sys>
        <div class="sys-head"><span class="cap">03 · QC tools in Python and AI</span><span class="cap">County Group</span></div>
        <div class="qc" aria-hidden="true">
          <div class="qc-bar"><span>blog-audit-checker</span><span class="qc-t">running</span></div>
          <ul>{checks.map((c, i) => <li style={`--k:${i}`}><i>✓</i>{c}</li>)}</ul>
          <div class="qc-prog"><i></i></div>
        </div>
        <div class="sys-res two"><div><b>25–30 → 6–8 min</b><span>per blog audit</span></div><div><b>~20 h</b><span>of QC saved a month</span></div></div>
      </article>
    </div>
    <p class="sys-note cap rv">The chat, the leads and the checklist illustrate the real flows. The results are from the work.</p>
  </div>
</section>
