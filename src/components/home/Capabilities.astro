---
// What I can do for a business. On desktop, hovering a row floats its work next to the cursor;
// on phones each row shows its image inline.
import { small } from '../../data/img';
const caps = [
  ['Performance marketing', 'Meta, Google, DV360 and partner networks. Account audits, restructures, creative testing and scaling against CPL and ROAS, not vanity metrics.', 'show/travel-operators/03.webp'],
  ['SEO & AI search', 'Technical SEO, schema and content built to be cited by ChatGPT, Gemini and AI Overviews as well as ranked by Google.', 'sites/earavat-new-desktop.webp'],
  ['Websites & Shopify', 'Fast, mobile-first sites and stores in Astro and Shopify, designed to convert and scoring 94 to 99 on mobile.', 'show/the-better-beings/02.webp'],
  ['WhatsApp automation', 'Wati and WhatFlow bots that qualify, tag, send brochures and nurture, so sales only talks to people ready to buy.', 'show/real-estate/01.webp'],
  ['Tracking & attribution', 'Meta CAPI, offline conversions, GA4, GTM and UTM discipline, so every rupee can be traced to a lead or a sale.', 'show/real-estate/02.webp'],
  ['Creative & motion', 'Statics, reels and brand films made in house and in code, cut to the beat and built for the feed.', 'ads/static-05.webp'],
];
---
<section id="services">
  <div class="wrap">
    <div class="sec-head">
      <p class="eyebrow rv">What I do for a business</p>
      <h2 class="h2 rv">The whole funnel, <em>one person.</em></h2>
    </div>
    <div class="caps" data-caps>
      {caps.map(([h, p, img], i) => (
        <div class="capr rv" data-peek={i}>
          <span class="n">{String(i + 1).padStart(2, '0')}</span>
          <h3>{h}</h3>
          <p>{p}</p>
          <img src={small(img)} alt="" loading="lazy" decoding="async" />
        </div>
      ))}
    </div>
  </div>
  <div class="peek" aria-hidden="true" data-peekbox>
    {caps.map(([, , img]) => <img src={small(img)} alt="" loading="lazy" decoding="async" />)}
  </div>
</section>
