---
// The keycap mark, drawn as SVG so it stays sharp and takes the text colour (light on dark, dark on light).
interface Props { size?: number }
const { size = 44 } = Astro.props;
---
<svg class="logo" width={size * 1.14} height={size} viewBox="0 0 114 100" role="img" aria-label="CTRL the Funnel">
  <rect x="4" y="12" width="98" height="84" rx="12" fill="currentColor" />
  <rect x="12" y="2" width="98" height="82" rx="11" fill="var(--logo-face, #fff)" stroke="currentColor" stroke-width="3" />
  <text x="61" y="42" text-anchor="middle" font-family="Michroma, sans-serif" font-size="22" fill="currentColor" letter-spacing="1">CTRL</text>
  <rect x="24" y="50" width="74" height="2.6" fill="currentColor" />
  <text x="61" y="69" text-anchor="middle" font-family="Jost Variable, Jost, sans-serif" font-size="12.5" fill="currentColor" letter-spacing="2.2">the Funnel</text>
</svg>
