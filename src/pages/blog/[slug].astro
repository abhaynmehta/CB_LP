---
// One blog post: the answer-first summary, the article, its questions, the matching case study,
// the author and more posts. Structured data: BlogPosting, BreadcrumbList and FAQPage.
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getPosts, minutes, fmt, iso } from '../../data/posts';
import { topics, topicAbout } from '../../data/topics';
import { roles, me } from '../../data/me';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { data } = post;
const { Content } = await render(post);
const site = Astro.site!.href, url = new URL(Astro.url.pathname, Astro.site).href;
const topic = topics[data.topic];
const caseRole = data.related ? roles.find((r) => r.slug === data.related) : undefined;
const more = [...posts.filter((p) => p.id !== post.id && p.data.topic === data.topic), ...posts.filter((p) => p.id !== post.id && p.data.topic !== data.topic)].slice(0, 3);
const schema = [
  { '@context': 'https://schema.org', '@type': 'BlogPosting', '@id': `${url}#post`, headline: data.title, description: data.description, abstract: data.summary,
    datePublished: iso(data.pubDate), dateModified: iso(data.updated ?? data.pubDate), url, mainEntityOfPage: url, inLanguage: 'en-IN',
    author: { '@id': `${site}#me` }, publisher: { '@id': `${site}#me` }, image: `${site}og.jpg`, keywords: data.keyphrase,
    articleSection: topic.name, about: topicAbout[data.topic].map((name) => ({ '@type': 'Thing', name })), wordCount: (post.body ?? '').split(/\s+/).length, isPartOf: { '@id': `${site}blog/#blog` } },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Abhay Mehta', item: site },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}blog/` },
    { '@type': 'ListItem', position: 3, name: topic.name, item: `${site}blog/topic/${data.topic}/` },
    { '@type': 'ListItem', position: 4, name: data.title, item: url },
  ] },
  ...(data.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: data.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] : []),
];
---
<Base title={data.seoTitle ?? data.title} description={data.description} schema={schema}>
  <article class="post">
    <header class="post-hero wrap">
      <p class="eyebrow"><a href="/blog/">Blog</a> <span aria-hidden="true">·</span> <a href={`/blog/topic/${data.topic}/`}>{topic.name}</a></p>
      <h1 class="post-title">{data.title}</h1>
      <p class="post-meta cap">By <a href="/">Abhay Mehta</a> · <time datetime={iso(data.pubDate)}>{fmt(data.pubDate)}</time>{data.updated && <> · Updated <time datetime={iso(data.updated)}>{fmt(data.updated)}</time></>} · {minutes(post)} min read</p>
      <div class="post-short"><span class="cap">In short</span><p>{data.summary}</p></div>
    </header>
    <div class="post-body wrap"><Content /></div>
    {data.faq.length > 0 && (
      <section class="post-faq wrap" aria-labelledby="qa">
        <h2 id="qa">Questions people ask</h2>
        <dl class="faq">{data.faq.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}</dl>
      </section>
    )}
    <div class="post-end wrap">
      {caseRole && (
        <a class="post-case" href={`/work/${caseRole.slug}/`}>
          <span class="cap">The case study</span>
          <b>{caseRole.org}</b>
          <span>{caseRole.title} · {caseRole.dates}</span>
          <em>Read the case →</em>
        </a>
      )}
      <aside class="post-author">
        <span class="cap">About the author</span>
        <p><b>Abhay Mehta</b> is a digital marketing lead in Delhi NCR with 6 years across 40+ brands in real estate, hospitality, travel and D2C. He runs Meta, Google and DV360, works on SEO and AI search, and builds his own tracking and automation (B.Tech, Computer Science).</p>
        <p class="ctas"><a class="btn" href="/">Portfolio</a><a class="btn" href={me.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a><a class="btn" href={me.cv} download>CV ↓</a></p>
      </aside>
    </div>
    {more.length > 0 && (
      <nav class="post-more wrap" aria-label="More posts">
        <p class="eyebrow">Keep reading</p>
        <ul class="post-list">{more.map((p) => (
          <li><a href={`/blog/${p.id}/`}><span class="cap">{topics[p.data.topic].name}</span><b>{p.data.title}</b><span>{p.data.description}</span></a></li>
        ))}</ul>
      </nav>
    )}
  </article>
</Base>
