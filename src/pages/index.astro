---
// Home (v7): CTRL the Funnel, a one-stop business solutions team, in its own brand and tone
// (ink, paper, amber, keycaps, Michroma and Jost) with the Veyra concept's motion. Scroll drives
// everything: a WebGL funnel that ends by building the CTRL keycap, a 3D services keyboard, a
// rolling industries reel, a work arc that turns as you scroll, and a team of keycaps.
// The previous home (v5, noir and gold) is kept in src/components/home and in git history.
import '@fontsource-variable/jost';
import '@fontsource/michroma';
import '../ctf/ctf.css';
import Logo from '../components/ctf/Logo.astro';
import { agency, heroStats, stages, close, clients, keyRows, industries, work, disciplines, teamStats, caseHref } from '../data/agency';
import { me } from '../data/me';

const title = `${agency.name} · ${agency.kind}, New Delhi`;
const description = agency.description;
const canonical = new URL('/', Astro.site).href;
const noindex = process.env.NOINDEX === '1';
const schema = [{ '@context': 'https://schema.org', '@type': 'Organization', name: agency.name, url: agency.url, email: `mailto:${agency.email}`, telephone: agency.phone, description, address: { '@type': 'PostalAddress', addressLocality: 'New Delhi', addressCountry: 'IN' }, founder: { '@type': 'Person', name: me.name, sameAs: [me.linkedin] } }];
const stops = [0, 0.2, 0.4, 0.6, 0.8, 1];
const chapterNames = ['Top', ...stages.map((s) => s.name), 'CTRL'];
const keyData = keyRows.map((r) => ({ name: r.name, keys: r.keys.map(([k, p, s]) => ({ k, p, href: caseHref(s) })) }));
const half = Math.ceil(clients.length / 2), clientRows = [clients.slice(0, half), clients.slice(half)];
const pad = (n: number) => String(n).padStart(2, '0');
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description.slice(0, 158)} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#111113" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description.slice(0, 200)} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  {schema.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <script is:inline>var d=document.documentElement;d.classList.add('js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('motion');</script>
</head>
<body>
  <a class="skip" href="#services">Skip the funnel animation</a>

  <header class="hd" id="hd">
    <div class="wrap">
      <a class="hd-mark" href="#funnel" aria-label={`${agency.name}, top`}><Logo size={40} /><span>Business solutions<br />New Delhi</span></a>
      <nav class="hd-nav" id="nav" aria-label="Main">
        <a href="#funnel">Funnel</a><a href="#services">Services</a><a href="#industries">Industries</a><a href="#work">Work</a><a href="#team">Team</a><a href="#concept">Concept</a>
      </nav>
      <span class="keys-hint" aria-hidden="true"><kbd>1</kbd><kbd>2</kbd><kbd>3</kbd><kbd>4</kbd></span>
      <a class="key key-sm" href="#contact"><span class="key-cap">Let’s talk</span></a>
    </div>
  </header>

  <main>
    <!-- 1. The funnel: scroll falls from the feed to the sale, then every particle builds the CTRL key -->
    <section class="journey" id="funnel" data-tone="ink" aria-label="The funnel">
      <div class="j-stage">
        <canvas id="funnelgl" aria-hidden="true"></canvas>
        <div class="j-glow" aria-hidden="true"></div>
        <div class="j-ui">
          <div class="j-chapters" aria-live="polite">
            <article class="chapter" data-at="0">
              <p class="lbl">{agency.kind} · New Delhi · {agency.years}</p>
              <h1 class="h1">We own every step between a scroll and a <span class="amb">sale.</span></h1>
              <div class="hero-sub">
                <p>One team for strategy, content, production, ads, websites, search and automation. Scroll down through the funnel we build for every client.</p>
                <a class="key amber" href="#contact"><span class="key-cap">Start a project <span class="ar">→</span></span></a>
              </div>
              <div class="ticker">{heroStats.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}</div>
            </article>
            {stages.map((s, i) => (
              <article class="chapter" data-at={stops[i + 1]}>
                <p class="stage-no"><kbd>{s.key}</kbd><span class="lbl">Stage {s.key} · {s.name}</span></p>
                <h2>{s.verb}</h2>
                <p class="line">{s.line}</p>
                <div class="proofs">{s.proof.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}</div>
              </article>
            ))}
            <article class="chapter finale" data-at="1">
              <p class="lbl">{close.label}</p>
              <h2>Whatever you sell, we take <span class="amb">CTRL.</span></h2>
              <p class="line">{close.line}</p>
              <div class="hero-sub"><a class="key amber" href="#contact"><span class="key-cap">Start a project <span class="ar">→</span></span></a><a class="tlink" href="#services">See everything we do</a></div>
            </article>
          </div>
          <div class="j-foot">
            <nav class="st-nav" id="stNav" aria-label="Funnel chapters">
              {chapterNames.map((n, i) => <button type="button" data-p={stops[i]} aria-label={`Go to ${n}`}><i></i><span>{pad(i)} {n}</span></button>)}
            </nav>
            <p class="hint" id="hint"><span>Scroll</span><i aria-hidden="true"></i></p>
            <p class="readout" id="readout">The whole funnel<br />Press 1 to 4</p>
          </div>
        </div>
        {stages.map((s) => <span class="ring-tag" data-ring aria-hidden="true"><kbd>{s.key}</kbd>{s.name}</span>)}
      </div>
    </section>

    <!-- 2. Trusted by: client keycaps in two strips -->
    <section class="clients ink" data-tone="ink" aria-label="Clients">
      <p class="lbl clients-lbl">Trusted by brands, creators and institutions</p>
      {clientRows.map((row, r) => (
        <div class={`crow${r ? ' rev' : ''}`}>
          <div class="ctrack">
            {[...row, ...row].map((c, k) => (
              <span class="ckey" aria-hidden={k >= row.length ? 'true' : undefined}>
                {c.img ? <img src={`/work/logos/${c.img}.webp`} alt={k >= row.length ? '' : c.name} loading="lazy" decoding="async" /> : <span>{c.name}</span>}
              </span>
            ))}
          </div>
        </div>
      ))}
    </section>

    <!-- 3. Services keyboard: assembles, then lights one funnel row at a time -->
    <section class="keys ppr" id="services" data-tone="paper">
      <div class="k-stage">
        <canvas id="keysgl" aria-hidden="true"></canvas>
        <div class="k-copy">
          <p class="lbl">Everything we do</p>
          <h2 class="h2">Every service is <span class="amb">a key.</span></h2>
          <p class="lead">Each one links to the work that proves it. Keep scrolling and the keyboard lights up one funnel stage at a time.</p>
          <ul class="rows" id="rows">
            {keyRows.map((r, i) => (
              <li data-r={i}>
                <div class="rh"><b>{r.name}</b><span>{r.line}</span></div>
                <div class="rk">{r.keys.map(([k, p, s]) => <a href={caseHref(s)}>{k}<small>{p}</small></a>)}</div>
              </li>
            ))}
          </ul>
        </div>
        <div class="k-tip" id="ktip" aria-hidden="true"></div>
      </div>
      <script type="application/json" id="keydata" set:html={JSON.stringify(keyData)} />
    </section>

    <!-- 4. Industries: one reel, rolled by scroll -->
    <section class="ind ink" id="industries" data-tone="ink" style={`--n:${industries.length}`}>
      <div class="ind-stage">
        <div class="ind-bg" aria-hidden="true">{industries.map((x, i) => <img src={`/work/${x.img}.w700.webp`} srcset={`/work/${x.img}.w700.webp 700w, /work/${x.img}.webp 1400w`} sizes="100vw" alt="" data-i={i} loading="lazy" decoding="async" />)}</div>
        <div class="ind-ui">
          <div class="ind-top">
            <p class="lbl">Not one niche</p>
            <h2 class="ind-head">{industries.length} industries. <span class="amb">Results in every one.</span></h2>
          </div>
          <div class="ind-roll" aria-hidden="true"><div class="ind-track" id="indTrack">{industries.map((x) => <span>{x.short}</span>)}</div></div>
          <div class="ind-proofs" aria-live="polite">
            {industries.map((x, i) => (
              <div class="ind-p" data-i={i}>
                <p class="ind-name">{pad(i + 1)} · {x.name}</p>
                <b>{x.num}</b>
                <span>{x.what}</span>
                <small>{x.who}</small>
              </div>
            ))}
          </div>
          <div class="ind-foot"><div class="ind-bar"><i id="indBar"></i></div><span class="ind-count" id="indCount">01 / {pad(industries.length)}</span></div>
        </div>
      </div>
    </section>

    <!-- 5. Work: the arc turns as you scroll -->
    <section class="work ink grain" id="work" data-tone="ink" style={`--n:${work.length}`}>
      <div class="w-stage">
        <div class="wrap w-head">
          <div style="display:grid;gap:14px"><p class="lbl">Featured work</p><h2 class="h2">34 clients. <span class="amb">Real numbers.</span></h2></div>
          <p class="lead">Every figure comes from an ad account, a report or a public count. Keep scrolling and the cases come to you.</p>
        </div>
        <div class="arc-stage" id="arc" tabindex="0" aria-roledescription="carousel" aria-label="Featured work. Use the left and right arrow keys to move.">
          {work.map((w, i) => (
            <article class="wcard" data-i={i} aria-label={w.client}>
              <div class="wcard-img"><img src={`/work/${w.img}.w700.webp`} alt={`${w.client} work`} loading="lazy" decoding="async" draggable="false" /></div>
              <div class="wcard-body">
                <div class="wcard-top"><b>{w.client}</b><span>{w.sector}</span></div>
                <h3>{w.head}</h3>
                <div class="kpis">{w.kpi.map(([v, l]) => <div><b>{v}</b><span>{l}</span></div>)}</div>
                <a class="key key-sm amber go" href={caseHref(w.slug)}><span class="key-cap">Open case <span class="ar">→</span></span></a>
              </div>
            </article>
          ))}
        </div>
        <div class="arc-controls">
          <button class="round" type="button" id="prev" aria-label="Previous case">←</button>
          <span class="arc-count" id="count" aria-live="polite">01 / {pad(work.length)}</span>
          <button class="round" type="button" id="next" aria-label="Next case">→</button>
          <a class="tlink all-link" href={`${agency.url}/work/`}>All 34 clients ↗</a>
        </div>
      </div>
    </section>

    <!-- 6. Team -->
    <section class="pad ppr team" id="team" data-tone="paper">
      <div class="wrap">
        <div class="sec-head split">
          <div style="display:grid;gap:18px"><p class="lbl rv">Who you work with</p><h2 class="h2 rv">Led by a team of <span class="amb">specialists.</span></h2></div>
          <p class="lead rv">Six years in the market. Every discipline a business needs sits in one room, so nothing gets lost between agencies and every number has one owner.</p>
        </div>
        <div class="t-stats rv">{teamStats.map(([v, l]) => <div><b data-count={v}>{v}</b><span>{l}</span></div>)}</div>
        <div class="t-keys" id="tkeys">
          {disciplines.map(([h, p], i) => (
            <button class="tkey" type="button" style={`--k:${i}`}><span class="tkey-cap"><small>{pad(i + 1)}</small><b>{h}</b><span>{p}</span></span></button>
          ))}
        </div>
        <p class="t-note rv">Founded in New Delhi by {me.name}. <a class="tlink" href={me.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></p>
      </div>
    </section>

    <!-- 7. Concept: Veyra -->
    <section class="pad ink grain" id="concept" data-tone="ink">
      <div class="wrap">
        <div class="sec-head split">
          <div style="display:grid;gap:18px"><p class="lbl rv">Concept · Real estate launch</p><h2 class="h2 rv">One launch, <span class="amb">built end to end.</span></h2></div>
          <p class="lead rv">Our ads send buyers to a launch page. Veyra is our concept for that page, designed and coded by hand: a night journey, 3D towers you can take apart, and the tools that turn a visitor into a site visit.</p>
        </div>
        <div class="vy-grid">
          {[
            ['01 · Night journey', 'A city made in code, flown through by scroll.', 'journey', '/veyra/#journey'],
            ['02 · The towers', 'Taken apart floor by floor.', 'floors', '/veyra/#floors'],
            ['03 · Inventory', 'A page that books site visits.', 'homes', '/veyra/#homes'],
          ].map(([n, h, img, href]) => (
            <a class="vy-card rv" href={href}>
              <span class="bw"><span class="bw-bar"><i></i><i></i><i></i><span>veyra · {img}</span></span><span class="bw-view"><img src={`/work/veyra/${img}.w700.webp`} srcset={`/work/veyra/${img}.w700.webp 700w, /work/veyra/${img}.webp 1440w`} sizes="(max-width: 900px) 92vw, 30vw" alt={`Veyra concept: ${h}`} loading="lazy" decoding="async" /></span></span>
              <span class="cap">{n}</span><h3>{h}</h3>
            </a>
          ))}
        </div>
        <div class="vy-foot">
          <a class="key amber" href="/veyra/"><span class="key-cap">Open the live concept <span class="ar">→</span></span></a>
          <div class="chips">{['three.js', 'GLSL shaders', 'Scroll-driven 3D', 'Astro', 'Lead capture'].map((c) => <span>{c}</span>)}</div>
        </div>
        <p class="fine">Veyra is a fictional developer. Prices, inventory and figures in the concept are examples.</p>
      </div>
    </section>

    <!-- 8. Contact -->
    <section class="pad ink" id="contact" data-tone="ink" style="border-top:1px solid var(--line-ink)">
      <div class="wrap contact-grid">
        <div style="display:grid;gap:22px;align-content:start">
          <p class="lbl rv">Start a project</p>
          <h2 class="h2 rv">Tell us what you sell. <span class="amb">We’ll map the funnel.</span></h2>
          <p class="lead rv">From a first idea to a business that needs its next level. Pick the stages that leak; the brief opens in WhatsApp, written out, so nothing is stored anywhere else.</p>
          <div class="direct rv">
            <a href={`https://wa.me/${agency.wa}`} target="_blank" rel="noopener"><span>WhatsApp</span><span>{agency.phone}</span></a>
            <a href={`mailto:${agency.email}`}><span>Email</span><span>{agency.email}</span></a>
            <a href={`tel:${agency.phone.replace(/\s/g, '')}`}><span>Call</span><span>{agency.phone}</span></a>
          </div>
        </div>
        <form class="brief rv" id="brief" data-wa={agency.wa} novalidate>
          <div class="two">
            <label for="bName">Your name<input id="bName" autocomplete="name" placeholder="e.g. Riya Kapoor" /></label>
            <label for="bBiz">Business<input id="bBiz" autocomplete="organization" placeholder="Brand, website or Instagram" /></label>
          </div>
          <div class="fl">Where does it leak?
            <div class="picks" id="picks">{stages.map((s) => <button type="button" aria-pressed="false" data-stage={s.name}><kbd>{s.key}</kbd>{s.name}</button>)}</div>
          </div>
          <label for="bBudget">Monthly budget
            <select id="bBudget"><option>Under ₹50K</option><option selected>₹50K – ₹2L</option><option>₹2L – ₹10L</option><option>Above ₹10L</option><option>Not sure yet</option></select>
          </label>
          <label for="bNote">Anything else? <span style="font-weight:300;color:var(--on-ink-2)">(optional)</span><textarea id="bNote" placeholder="Goal, timeline, links"></textarea></label>
          <p class="err" id="bErr" aria-live="polite"></p>
          <button class="key amber" type="submit" style="justify-self:start"><span class="key-cap">Send the brief on WhatsApp <span class="ar">→</span></span></button>
        </form>
      </div>
    </section>
  </main>

  <footer class="ft">
    <div class="wrap">
      <p class="ft-big" aria-hidden="true">CTRL the Funnel</p>
      <div class="ft-row">
        <span>© {year} {agency.name} · {agency.kind} · {agency.city}</span>
        <span><a href={agency.url} target="_blank" rel="noopener">Agency site ↗</a> · <a href="/veyra/">Veyra concept</a> · <a href={me.linkedin} target="_blank" rel="noopener">Founder on LinkedIn</a></span>
      </div>
    </div>
  </footer>

  <script>
    import '../ctf/main.js';
  </script>
</body>
</html>
