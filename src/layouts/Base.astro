---
import '../styles/global.css';
import { me } from '../data/me';

interface Props { title?: string; description?: string; schema?: object[]; keywords?: string[]; article?: { published: string; modified: string; section: string }; image?: string; imageAlt?: string }
const { title, description = me.seo, schema = [], keywords = [], article, image = '/og.jpg', imageAlt } = Astro.props;
const ogImage = new URL(image, Astro.site).href;
const kw = [...keywords, 'Abhay Mehta', 'digital marketing lead Delhi NCR', 'real estate digital marketing', 'Meta Ads', 'Google Ads', 'SEO', 'AEO', 'GEO'];
const fullTitle = title ? `${title} · ${me.name}` : `${me.name} · Digital Marketing Lead in Delhi NCR | Meta, Google, SEO`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const noindex = process.env.NOINDEX === '1';
// The person this site is about, referenced by @id from every other piece of structured data.
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': `${Astro.site}#me`, name: me.name, givenName: 'Abhay', familyName: 'Mehta',
  alternateName: ['ANM', 'Abhay N Mehta'], url: Astro.site?.href, jobTitle: 'Digital Marketing Lead', description: me.summary,
  email: `mailto:${me.email}`, sameAs: [me.linkedin, me.github],
  address: { '@type': 'PostalAddress', addressLocality: 'Delhi NCR', addressCountry: 'IN' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Guru Gobind Singh Indraprastha University' },
  knowsAbout: ['Digital marketing', 'Performance marketing', 'Meta Ads', 'Google Ads', 'DV360', 'Conversions API', 'SEO', 'Answer engine optimisation', 'Generative engine optimisation', 'WhatsApp automation', 'Shopify', 'Python', 'Astro'],
};
const website = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${Astro.site}#site`, name: me.name, url: Astro.site?.href, inLanguage: 'en-IN', publisher: { '@id': `${Astro.site}#me` } };
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description.slice(0, 158)} />
  <meta name="keywords" content={[...new Set(kw)].join(', ')} />
  <meta name="author" content={me.name} />
  {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  <link rel="canonical" href={canonical} />
  <meta name="google-site-verification" content="sMgUnVdlVc6JxjbMYWYwDwdEYXCpDVagrPXCI1ecwUo" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0b0a08" />
  <link rel="preload" href="/fonts/bodoni-moda-latin-opsz-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/bodoni-moda-latin-opsz-italic.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/hanken-grotesk-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Abhay Mehta: notes from the work" href="/rss.xml" />
  <meta property="og:type" content={article ? 'article' : 'profile'} />
  <meta property="og:site_name" content={me.name} />
  <meta property="og:locale" content="en_IN" />
  {article && <><meta property="article:published_time" content={article.published} /><meta property="article:modified_time" content={article.modified} /><meta property="article:section" content={article.section} /><meta property="article:author" content={me.linkedin} /></>}
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description.slice(0, 200)} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description.slice(0, 200)} />
  <meta name="twitter:image" content={ogImage} />
  {[person, website, ...schema].map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  <script is:inline>var d=document.documentElement;d.classList.add('js');if(!matchMedia('(prefers-reduced-motion: reduce)').matches)d.classList.add('motion');try{if(sessionStorage.getItem('am-seen'))d.classList.add('seen');sessionStorage.setItem('am-seen','1')}catch(e){d.classList.add('seen')}</script>
</head>
<body>
  <div class="ld" aria-hidden="true">
    <span class="ld-mark">Abhay Mehta</span>
    <span class="ld-n"></span>
    <span class="ld-cap cap">Performance · Growth · Code</span>
    <span class="ld-bar"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>
  <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="liquid" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.008 0.016" numOctaves="2" seed="7" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G" data-liquid /></filter></svg>
  <div class="prog" aria-hidden="true"></div>
  <a class="skip" href="#main">Skip to content</a>
  <header class="hd" data-hd>
    <a href="/" class="hd-mark">AM<span>.</span><span class="sr"> Abhay Mehta, home</span></a>
    <nav class="hd-nav" aria-label="Main">
      <a href="/#impact">Impact</a><a href="/#work">Work</a><a href="/blog/">Blog</a><a href="/#services">Services</a><a href="/#contact">Contact</a><a href={me.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
    </nav>
    <a class="pill" href={me.cv} download data-magnet>CV ↓</a>
  </header>
  <main id="main"><slot /></main>
  <footer class="ft">
    <p class="ft-big" aria-hidden="true">Abhay Mehta</p>
    <div class="ft-row"><span>© {new Date().getFullYear()} {me.name} · {me.city}</span><span><a href={me.linkedin} target="_blank" rel="noopener">LinkedIn</a> · <a href={`mailto:${me.email}`}>{me.email}</a></span></div>
  </footer>
  <div class="cursor" aria-hidden="true" data-cursor><span></span></div>
  <div class="cursor-ring" aria-hidden="true" data-ring></div>
  {me.ga4 && !noindex && (
    <script is:inline define:vars={{ id: me.ga4 }}>
      window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date()); gtag('config', id);
      addEventListener('load', () => setTimeout(() => { const s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id; document.head.append(s); }, 1500));
    </script>
  )}
  <script>
    import '../scripts/ui.js';
    const go = () => import('../scripts/motion.js');
    'requestIdleCallback' in window ? requestIdleCallback(go, { timeout: 1200 }) : setTimeout(go, 300);
  </script>
</body>
</html>
