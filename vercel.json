{
  "framework": null,
  "installCommand": "echo 'redirect only: the site lives on Cloudflare (npm run deploy)'",
  "buildCommand": "mkdir -p vercel-redirect && echo ok > vercel-redirect/index.html",
  "outputDirectory": "vercel-redirect",
  "trailingSlash": false,
  "redirects": [
    { "source": "/", "destination": "https://anm.abhaynmehta.workers.dev/", "permanent": true },
    { "source": "/(.*)", "destination": "https://anm.abhaynmehta.workers.dev/$1", "permanent": true }
  ]
}
