{
  // Live site: https://anm.abhaynmehta.workers.dev  ->  `npm run deploy`
  // Hidden preview (noindex): https://abhay-luxury.abhaynmehta.workers.dev  ->  `npm run deploy:preview`
  // Domain move: see docs/domain-move.md (set CANONICAL_HOST below + SITE_URL at build).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anm",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "dist", "binding": "ASSETS", "not_found_handling": "404-page", "run_worker_first": true },
  "vars": { "CANONICAL_HOST": "" }
}
